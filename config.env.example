# Copy to the plugin's config dir, which `herdr plugin config-dir abtris.jira-pr`
# prints, as `config.env`. Every value is optional.

# Jira instance. Defaults to the `server:` value in the ankitpokhrel/jira-cli
# config at ~/.config/.jira/.config.yml when that file exists.
# JIRA_URL=https://jira.example.com

# `bearer` for a personal access token (self-hosted Jira), `basic` for Jira
# Cloud, where the token pairs with JIRA_LOGIN.
# JIRA_AUTH=bearer
# JIRA_LOGIN=you@example.com

# The token itself. Herdr runs plugins non-interactively, so either paste it
# here or give a command that prints it. A command that prompts for biometrics
# will hang, so prefer a service account token or an unlocked secret.
# JIRA_API_TOKEN=...
# JIRA_API_TOKEN_CMD=op read "op://Private/Jira/credential"

# Which gh account to use per repo, matched on the repo's git user.email. The
# dotfiles `gh` shell wrapper is not loaded for plugins, so this repeats it.
# Leave empty to always use whichever gh account is active.
# GH_ACCOUNTS=you@personal.example=personal-login;you@work.example=work-login

# Sidebar token name. Must match the $name you put in ui.sidebar.agents rows.
# TOKEN_NAME=jira

# Seconds before a resolved line is looked up again. Events fire often, so this
# is what keeps gh and Jira from being hammered.
# CACHE_TTL=300

# How long Herdr keeps showing the line without a refresh, in milliseconds.
# TOKEN_TTL_MS=900000

# Characters of the Jira summary to keep. Herdr caps the whole line at 80.
# SUMMARY_MAX=48
