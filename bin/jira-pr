#!/usr/bin/env bash
# Report the Jira issue behind the current branch's pull request as Herdr pane
# metadata, and flag when the branch and the PR point at different issues.
set -euo pipefail

# Internal records use the unit separator, not a tab: tab counts as IFS
# whitespace, so bash collapses runs of it and an empty middle field silently
# shifts every field after it.
SEP=$'\037'
HERDR="${HERDR_BIN_PATH:-herdr}"
SOURCE_ID="abtris.jira-pr"
CONFIG_DIR="${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/$SOURCE_ID}"
STATE_DIR="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/$SOURCE_ID}"

TOKEN_NAME="jira"
CACHE_TTL=300
TOKEN_TTL_MS=900000
SUMMARY_MAX=48
JIRA_PROJECTS="KR,KRI"
KEY_PATTERN=""
LINK_WORDS='(fix(es|ed)?|close[sd]?|resolve[sd]?|implement(s|ed)?|relate[sd]? to|ticket|issue|jira)'
JIRA_URL=""
JIRA_AUTH="bearer"
JIRA_LOGIN=""
JIRA_API_TOKEN="${JIRA_API_TOKEN:-}"
JIRA_API_TOKEN_CMD=""
TOKEN_CMD_TIMEOUT=10
GH_ACCOUNTS="ladislav@prskavec.net=abtris;lprskavec@purestorage.com=lprskavec_pure"
OPEN_CMD=""

if [ -f "$CONFIG_DIR/config.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$CONFIG_DIR/config.env"
  set +a
fi

# Fall back to the ankitpokhrel/jira-cli config for the instance URL and login.
JIRA_CLI_CONFIG="$HOME/.config/.jira/.config.yml"
if [ -z "$JIRA_URL" ] && [ -f "$JIRA_CLI_CONFIG" ]; then
  JIRA_URL=$(sed -n 's/^server: *//p' "$JIRA_CLI_CONFIG" | head -1)
  [ -n "$JIRA_LOGIN" ] || JIRA_LOGIN=$(sed -n 's/^login: *//p' "$JIRA_CLI_CONFIG" | head -1)
fi
JIRA_URL="${JIRA_URL%/}"

# Restrict candidate keys to the project prefixes that actually exist here. This
# is what keeps branch names like fix/retry-2 from ever looking like a ticket.
# Longest prefix first, so KRI-1 is not read as the KR project.
if [ -z "$KEY_PATTERN" ]; then
  if [ -n "$JIRA_PROJECTS" ]; then
    KEY_PATTERN="($(printf '%s' "$JIRA_PROJECTS" |
      tr ',' '\n' |
      sed 's/[[:space:]]//g' |
      awk 'NF { print length, $0 }' |
      sort -rn |
      cut -d' ' -f2- |
      paste -sd'|' -))-[0-9]+"
  else
    KEY_PATTERN='[A-Za-z][A-Za-z0-9]+-[0-9]+'
  fi
fi

# Joins its arguments into one SEP-delimited record. Preserves empty fields,
# which is the whole reason records do not use tabs.
join_rec() {
  local first=1 field
  for field in "$@"; do
    if [ "$first" -eq 1 ]; then
      first=0
    else
      printf '%s' "$SEP"
    fi
    printf '%s' "$field"
  done
}

file_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

# Bounds a command's wall clock. The token command reaches a secret manager, and a
# locked vault would otherwise leave an event hook hanging on every pane focus.
bounded() {
  local secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  elif command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$secs" "$@"
  else
    "$@"
  fi
}

jira_token() {
  if [ -n "$JIRA_API_TOKEN" ]; then
    printf '%s' "$JIRA_API_TOKEN"
  elif [ -n "$JIRA_API_TOKEN_CMD" ]; then
    bounded "$TOKEN_CMD_TIMEOUT" sh -c "$JIRA_API_TOKEN_CMD" 2>/dev/null || true
  fi
}

# --- pane and repo discovery -------------------------------------------------

pane_id() {
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    printf '%s' "$HERDR_PANE_ID"
    return
  fi
  local json id
  for json in "${HERDR_PLUGIN_EVENT_JSON:-}" "${HERDR_PLUGIN_CONTEXT_JSON:-}"; do
    [ -n "$json" ] || continue
    id=$(printf '%s' "$json" |
      jq -r '.pane.pane_id // .pane_id // .focused_pane_id // empty' 2>/dev/null || true)
    if [ -n "$id" ]; then
      printf '%s' "$id"
      return
    fi
  done
}

pane_cwd() {
  local target="$1" json dir
  for json in "${HERDR_PLUGIN_EVENT_JSON:-}" "${HERDR_PLUGIN_CONTEXT_JSON:-}"; do
    [ -n "$json" ] || continue
    dir=$(printf '%s' "$json" |
      jq -r '.pane.foreground_cwd // .pane.cwd // .focused_pane_cwd // .workspace_cwd // empty' \
        2>/dev/null || true)
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      printf '%s' "$dir"
      return
    fi
  done
  # `pane get` wraps the pane in .result.pane, unlike `pane list`, which uses
  # .result.panes. Tolerate both shapes and a bare pane object.
  "$HERDR" pane get "$target" 2>/dev/null |
    jq -r 'if has("result") then .result else . end | (.pane // .) |
      .foreground_cwd // .cwd // empty' 2>/dev/null || true
}

# --- GitHub ------------------------------------------------------------------

# Herdr plugins run outside an interactive shell, so the dotfiles `gh` wrapper
# that picks an account per repo is not loaded. Repeat that selection here from
# the repo's configured user.email, or an EMU token gets used on personal repos.
gh_token_for() {
  local repo_root="$1" email account pair saved_ifs
  email=$(git -C "$repo_root" config user.email 2>/dev/null || true)
  [ -n "$email" ] || return 0
  account=""
  saved_ifs="$IFS"
  IFS=';'
  for pair in $GH_ACCOUNTS; do
    case "$pair" in
      "$email="*) account="${pair#*=}" ;;
    esac
  done
  IFS="$saved_ifs"
  [ -n "$account" ] || return 0
  gh auth token --user "$account" 2>/dev/null || true
}

repo_slug() {
  local url
  url=$(git -C "$1" config --get remote.origin.url 2>/dev/null || true)
  [ -n "$url" ] || return 0
  url="${url%.git}"
  url="${url%/}"
  printf '%s' "$url" | sed -n 's#^.*[:/]\([^/:]*\)/\([^/]*\)$#\1/\2#p'
}

gh_pr_list() {
  local slug="$1" branch="$2" state="$3" token="$4"
  if [ -n "$token" ]; then
    GH_TOKEN="$token" GH_PAGER="cat" gh pr list \
      --repo "$slug" --head "$branch" --state "$state" --limit 1 \
      --json number,title,body,url 2>/dev/null || true
  else
    GH_PAGER="cat" gh pr list \
      --repo "$slug" --head "$branch" --state "$state" --limit 1 \
      --json number,title,body,url 2>/dev/null || true
  fi
}

# Prints the PR as "number<SEP>title<SEP>body<SEP>url", or nothing.
find_pr() {
  local repo_root="$1" branch="$2" slug token state raw parsed
  slug=$(repo_slug "$repo_root")
  [ -n "$slug" ] || return 0
  token=$(gh_token_for "$repo_root")
  for state in open all; do
    raw=$(gh_pr_list "$slug" "$branch" "$state" "$token")
    parsed=$(printf '%s' "$raw" |
      jq -r '.[0] | select(.) |
        [(.number | tostring), (.title | gsub("[\r\n\t]+"; " ")),
         ((.body // "") | gsub("[\r\n\t]+"; " ")), (.url // "")] | join("\u001f")' \
        2>/dev/null || true)
    if [ -n "$parsed" ]; then
      printf '%s' "$parsed"
      return 0
    fi
  done
}

# --- Jira --------------------------------------------------------------------

# Prints "summary<SEP>status". Exit 3 = no such issue, 4 = Jira could not be
# consulted at all (missing token, network, auth).
# Populates JIRA_AUTH_ARGS for curl. Bearer is the personal access token form used
# by Jira Data Center; basic pairs JIRA_LOGIN with the token, as Jira Cloud wants.
JIRA_AUTH_ARGS=()
jira_auth_args() {
  local token="$1"
  if [ "$JIRA_AUTH" = "basic" ]; then
    JIRA_AUTH_ARGS=(-u "$JIRA_LOGIN:$token")
  else
    JIRA_AUTH_ARGS=(-H "Authorization: Bearer $token")
  fi
}

jira_issue() {
  local key="$1" token response code body
  local -a auth
  token=$(jira_token)
  if [ -z "$JIRA_URL" ] || [ -z "$token" ]; then
    return 4
  fi
  jira_auth_args "$token"
  auth=("${JIRA_AUTH_ARGS[@]}")
  response=$(curl -sS -m 8 -w '\n%{http_code}' "${auth[@]}" \
    -H 'Accept: application/json' \
    "$JIRA_URL/rest/api/2/issue/$key?fields=summary,status" 2>/dev/null || true)
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$code" in
    200) ;;
    404) return 3 ;;
    *) return 4 ;;
  esac
  printf '%s' "$body" |
    jq -r '[((.fields.summary // "") | gsub("[\r\n\t]+"; " ")),
            (.fields.status.name // "")] | join("\u001f")' 2>/dev/null || return 4
}

jira_issue_exists() {
  jira_issue "$1" >/dev/null 2>&1
}

extract_keys() {
  printf '%s' "$1" | grep -oiE "$KEY_PATTERN" 2>/dev/null | tr '[:lower:]' '[:upper:]' || true
}

# A PR body mentions tickets in passing far too often for a bare key to mean
# "this is the issue" — prose, examples, and follow-up notes all match. Only
# count keys inside a Jira link or behind a linking word.
extract_linked_keys() {
  local text="$1"
  {
    printf '%s' "$text" | grep -oiE "browse/$KEY_PATTERN" | sed 's#.*/##' || true
    printf '%s' "$text" |
      grep -oiE "${LINK_WORDS}[[:space:]:#-]*$KEY_PATTERN" |
      grep -oiE "$KEY_PATTERN" || true
  } | tr '[:lower:]' '[:upper:]' | sort -u | head -3
}

list_contains() {
  case " $2 " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

trim_summary() {
  local text="$1"
  # Real Jira summaries carry stray leading and trailing whitespace, which would
  # show up in the line as a doubled separator.
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  if [ "${#text}" -gt "$SUMMARY_MAX" ]; then
    text="${text:0:$SUMMARY_MAX}"
    text="${text%"${text##*[![:space:]]}"}"
    printf '%s…' "$text"
  else
    printf '%s' "$text"
  fi
}

# --- resolution --------------------------------------------------------------

# Reads candidate "key<SEP>origin" lines on stdin and prints the first key Jira
# confirms as "key<SEP>summary<SEP>status<SEP>origin". Exit 3 = candidates
# existed but none resolved, 4 = Jira unreachable, 1 = no candidates.
first_real_issue() {
  local key origin details rc saw=0 unreachable=0
  while IFS="$SEP" read -r key origin; do
    [ -n "$key" ] || continue
    saw=1
    details=$(jira_issue "$key") && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      join_rec "$key" "$details" "$origin"; printf '\n'
      return 0
    fi
    if [ "$rc" -eq 4 ]; then
      unreachable=1
    fi
  done
  if [ "$unreachable" -eq 1 ]; then
    return 4
  fi
  if [ "$saw" -eq 1 ]; then
    return 3
  fi
  return 1
}

# Prints the first key from the candidate list, for the failure messages.
first_key() {
  printf '%s' "$1" | head -1 | cut -d"$SEP" -f1
}

branch_slug() {
  printf '%s|%s' "$1" "$2" | shasum | cut -d' ' -f1
}

# A ticket pinned through the popup, for work whose branch name does not carry
# one. It outranks the branch as the statement of what was assigned.
pin_file() {
  printf '%s/pins/%s' "$STATE_DIR" "$(branch_slug "$1" "$2")"
}

read_pin() {
  local file
  file=$(pin_file "$1" "$2")
  [ -f "$file" ] && cat "$file" || true
}

# Prints "line<SEP>pr_url<SEP>key", where line is what the sidebar shows. An
# empty result means there is nothing to say and the row should disappear.
compose() {
  local repo_root="$1" branch="$2"
  local pr number title body url pin branch_keys title_keys body_keys candidates key
  local resolved status summary issue_status origin key2 assigned line=""

  pin=$(read_pin "$repo_root" "$branch")
  pr=$(find_pr "$repo_root" "$branch")

  if [ -z "$pr" ]; then
    # No PR yet. A pinned ticket is still worth showing, so you can see what the
    # agent is supposed to be working on before it opens anything.
    if [ -n "$pin" ] && resolved=$(jira_issue "$pin"); then
      IFS="$SEP" read -r summary issue_status <<<"$resolved"
      line="$pin $(trim_summary "$summary")"
      if [ -n "$issue_status" ]; then
        line="$line · $issue_status"
      fi
      join_rec "$line" "" "$pin"
    fi
    return 0
  fi

  IFS="$SEP" read -r number title body url <<<"$pr"

  branch_keys=$(extract_keys "$branch")
  title_keys=$(extract_keys "$title")
  body_keys=$(extract_linked_keys "${body:-}")

  candidates=""
  if [ -n "$pin" ]; then candidates+="$pin${SEP}assigned"$'\n'; fi
  for key in $branch_keys; do candidates+="$key${SEP}branch"$'\n'; done
  for key in $title_keys; do candidates+="$key${SEP}PR title"$'\n'; done
  for key in $body_keys; do candidates+="$key${SEP}PR body"$'\n'; done

  resolved=$(printf '%s' "$candidates" | first_real_issue) && status=0 || status=$?

  case "$status" in
    0)
      IFS="$SEP" read -r key summary issue_status origin <<<"$resolved"
      assigned=0
      case "$origin" in
        assigned | branch) assigned=1 ;;
      esac

      if [ "$assigned" -eq 1 ]; then
        # The assignment says one ticket and the PR says another: the usual way a
        # PR ends up linked to the wrong issue.
        for key2 in $title_keys $body_keys; do
          if [ "$key2" != "$key" ] && jira_issue_exists "$key2"; then
            line="⚠ #$number $key ($origin) ≠ $key2 (PR)"
            break
          fi
        done
        # The assignment has to reappear in the PR title. A ticket that never got
        # that far is the agent quietly dropping it.
        if [ -z "$line" ] && ! list_contains "$key" "$title_keys"; then
          line="⚠ #$number $key not in PR title"
        fi
      else
        for key2 in $branch_keys; do
          if [ "$key2" != "$key" ] && jira_issue_exists "$key2"; then
            line="⚠ #$number $key2 (branch) ≠ $key (PR)"
            break
          fi
        done
      fi

      if [ -z "$line" ]; then
        line="#$number $key $(trim_summary "$summary")"
        if [ -n "$issue_status" ]; then
          line="$line · $issue_status"
        fi
      fi
      join_rec "$line" "$url" "$key"
      ;;
    3)
      key=$(first_key "$candidates")
      join_rec "⚠ #$number $key not in Jira" "$url" ""
      ;;
    4)
      key=$(first_key "$candidates")
      if [ -n "$key" ]; then
        join_rec "#$number $key · jira?" "$url" "$key"
      else
        join_rec "#$number" "$url" ""
      fi
      ;;
    # No ticket anywhere is normal: chore work, triage, and repos that do not
    # use Jira at all. Show the PR alone rather than nagging.
    *) join_rec "#$number" "$url" "" ;;
  esac
}

# Reports the display line as $jira and the resolved key as $jira_key. The key is
# there so an agent in this pane can read its own assigned ticket back out of
# `herdr pane get` and use it when it names a branch or writes a PR title.
report() {
  local target="$1" line="$2" key="$3"
  local -a args=(pane report-metadata "$target" --source "$SOURCE_ID")
  if [ -n "$line" ]; then
    args+=(--token "$TOKEN_NAME=$line" --ttl-ms "$TOKEN_TTL_MS")
  else
    args+=(--clear-token "$TOKEN_NAME")
  fi
  if [ -n "$key" ]; then
    args+=(--token "${TOKEN_NAME}_key=$key" --ttl-ms "$TOKEN_TTL_MS")
  else
    args+=(--clear-token "${TOKEN_NAME}_key")
  fi
  "$HERDR" "${args[@]}" >/dev/null
}

# Prints "repo_root<SEP>branch" for the pane Herdr invoked us for, or nothing.
pane_repo() {
  local target="$1" cwd repo_root branch
  cwd=$(pane_cwd "$target")
  { [ -n "$cwd" ] && [ -d "$cwd" ]; } || return 0
  repo_root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
  [ -n "$repo_root" ] || return 0
  branch=$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [ -n "$branch" ] || return 0
  join_rec "$repo_root" "$branch"
}

# compose() through the cache, so the frequent events stay cheap.
resolve() {
  local repo_root="$1" branch="$2" force="${3:-0}" cache age value
  mkdir -p "$STATE_DIR/cache"
  cache="$STATE_DIR/cache/$(branch_slug "$repo_root" "$branch")"
  if [ "$force" -eq 0 ] && [ -f "$cache" ]; then
    age=$(($(date +%s) - $(file_mtime "$cache")))
    if [ "$age" -lt "$CACHE_TTL" ]; then
      cat "$cache"
      return 0
    fi
  fi
  value=$(compose "$repo_root" "$branch")
  printf '%s' "$value" >"$cache.tmp" && mv "$cache.tmp" "$cache"
  printf '%s' "$value"
}

invalidate() {
  rm -f "$STATE_DIR/cache/$(branch_slug "$1" "$2")"
}

cmd_refresh() {
  local force=0 target repo branch repo_root value line key
  if [ "${1:-}" = "--force" ]; then
    force=1
  fi

  target=$(pane_id)
  [ -n "$target" ] || exit 0

  repo=$(pane_repo "$target")
  if [ -z "$repo" ]; then
    report "$target" "" ""
    exit 0
  fi
  IFS="$SEP" read -r repo_root branch <<<"$repo"

  value=$(resolve "$repo_root" "$branch" "$force")
  IFS="$SEP" read -r line _ key <<<"$value"
  report "$target" "$line" "$key"
}

# Prints the ticket for the current pane's branch, for agents and scripts.
cmd_ticket() {
  local target repo repo_root branch value key
  target=$(pane_id)
  repo=$(pane_repo "$target")
  [ -n "$repo" ] || return 1
  IFS="$SEP" read -r repo_root branch <<<"$repo"
  value=$(resolve "$repo_root" "$branch")
  IFS="$SEP" read -r _ _ key <<<"$value"
  [ -n "$key" ] || return 1
  printf '%s\n' "$key"
}

open_url() {
  local url="$1" opener
  [ -n "$url" ] || return 0
  if [ -n "$OPEN_CMD" ]; then
    opener="$OPEN_CMD"
  elif command -v open >/dev/null 2>&1; then
    opener="open"
  elif command -v xdg-open >/dev/null 2>&1; then
    opener="xdg-open"
  else
    return 1
  fi
  "$opener" "$url" >/dev/null 2>&1 || return 1
}

# --- popup -------------------------------------------------------------------

# Herdr gives a popup entrypoint a real terminal, so this draws its own frame and
# reads one keystroke. Popups get no HERDR_PANE_ID; the underlying pane arrives
# through HERDR_PLUGIN_CONTEXT_JSON, which pane_id and pane_cwd already handle.
menu_row() {
  printf '  %s  %s\n' "$1" "$2"
}

cmd_menu() {
  local target repo repo_root branch value line pr_url key choice entry pin

  target=$(pane_id)
  repo=$(pane_repo "$target")
  if [ -z "$repo" ]; then
    printf '\n  Not a git branch in this pane.\n\n  press any key\n'
    read -rsn1 _ || true
    return 0
  fi
  IFS="$SEP" read -r repo_root branch <<<"$repo"

  value=$(resolve "$repo_root" "$branch")
  IFS="$SEP" read -r line pr_url key <<<"$value"
  pin=$(read_pin "$repo_root" "$branch")

  printf '\n  Jira PR — %s\n\n' "$branch"
  if [ -n "$pr_url" ]; then
    menu_row p "${line:-open the pull request}"
  else
    menu_row ' ' 'no pull request for this branch'
  fi
  if [ -n "$key" ]; then
    menu_row j "$key in Jira"
  fi
  menu_row a 'assign a ticket…'
  if [ -n "$pin" ]; then
    menu_row c "clear assigned $pin"
  fi
  printf '\n  esc  cancel\n'

  read -rsn1 choice || return 0
  case "$choice" in
    p) open_url "$pr_url" ;;
    j) [ -n "$key" ] && open_url "$JIRA_URL/browse/$key" ;;
    a)
      printf '\n  ticket: '
      read -r entry || return 0
      entry=$(printf '%s' "$entry" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')
      if [ -z "$entry" ]; then
        return 0
      fi
      if ! printf '%s' "$entry" | grep -qiE "^$KEY_PATTERN$"; then
        printf '  %s does not look like a ticket key.\n  press any key\n' "$entry"
        read -rsn1 _ || true
        return 0
      fi
      # Confirm it exists before pinning, so a typo does not become the answer.
      if ! jira_issue_exists "$entry" && [ -n "$(jira_token)" ]; then
        printf '  %s is not in Jira.\n  press any key\n' "$entry"
        read -rsn1 _ || true
        return 0
      fi
      mkdir -p "$STATE_DIR/pins"
      printf '%s' "$entry" >"$(pin_file "$repo_root" "$branch")"
      invalidate "$repo_root" "$branch"
      value=$(resolve "$repo_root" "$branch")
      IFS="$SEP" read -r line _ key <<<"$value"
      report "$target" "$line" "$key"
      ;;
    c)
      rm -f "$(pin_file "$repo_root" "$branch")"
      invalidate "$repo_root" "$branch"
      value=$(resolve "$repo_root" "$branch")
      IFS="$SEP" read -r line _ key <<<"$value"
      report "$target" "$line" "$key"
      ;;
  esac
}

cmd_doctor() {
  local tool
  printf 'plugin        %s\n' "$SOURCE_ID"
  printf 'config dir    %s\n' "$CONFIG_DIR"
  printf 'state dir     %s\n' "$STATE_DIR"
  printf 'sidebar token $%s\n' "$TOKEN_NAME"
  printf 'jira url      %s\n' "${JIRA_URL:-(unset)}"
  printf 'jira auth     %s\n' "$JIRA_AUTH"
  local token code who
  token=$(jira_token)
  if [ -n "$token" ]; then
    if [ -n "$JIRA_API_TOKEN_CMD" ]; then
      printf 'jira token    %s chars, from JIRA_API_TOKEN_CMD\n' "${#token}"
    else
      printf 'jira token    %s chars, from JIRA_API_TOKEN\n' "${#token}"
    fi
    # One request, so a rejected token is obvious here instead of showing up as a
    # sidebar full of "jira?". On-prem Jira can lock an account after repeated
    # failures, so this deliberately does not retry or try other auth modes.
    jira_auth_args "$token"
    code=$(curl -sS -m 10 -o /dev/null -w '%{http_code}' "${JIRA_AUTH_ARGS[@]}" \
      -H 'Accept: application/json' "$JIRA_URL/rest/api/2/myself" 2>/dev/null || true)
    case "$code" in
      200)
        who=$(curl -sS -m 10 "${JIRA_AUTH_ARGS[@]}" -H 'Accept: application/json' \
          "$JIRA_URL/rest/api/2/myself" 2>/dev/null | jq -r '.name // "?"' 2>/dev/null)
        printf 'jira auth     HTTP 200 as %s\n' "${who:-?}"
        ;;
      401 | 403)
        printf 'jira auth     HTTP %s — token rejected, or this instance restricts\n' "$code"
        printf '              /myself. Confirm with: jira issue view <KEY>\n'
        ;;
      429) printf 'jira auth     HTTP 429 — rate limited, wait before retrying\n' ;;
      *) printf 'jira auth     HTTP %s\n' "${code:-no response}" ;;
    esac
  else
    printf 'jira token    MISSING — set JIRA_API_TOKEN or JIRA_API_TOKEN_CMD in\n'
    printf '              %s/config.env\n' "$CONFIG_DIR"
  fi
  for tool in git gh jq curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '%-13s %s\n' "$tool" "$(command -v "$tool")"
    else
      printf '%-13s MISSING\n' "$tool"
    fi
  done
}

case "${1:-refresh}" in
  refresh)
    shift || true
    cmd_refresh "${1:-}"
    ;;
  menu) cmd_menu ;;
  ticket) cmd_ticket ;;
  doctor) cmd_doctor ;;
  *)
    printf 'usage: jira-pr [refresh [--force]|menu|ticket|doctor]\n' >&2
    exit 64
    ;;
esac
