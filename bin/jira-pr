#!/usr/bin/env bash
# Report the Jira issue behind the current branch's pull request as Herdr pane
# metadata, and flag when the branch and the PR point at different issues.
set -euo pipefail

TAB=$'\t'
HERDR="${HERDR_BIN_PATH:-herdr}"
SOURCE_ID="abtris.jira-pr"
CONFIG_DIR="${HERDR_PLUGIN_CONFIG_DIR:-$HOME/.config/herdr/plugins/$SOURCE_ID}"
STATE_DIR="${HERDR_PLUGIN_STATE_DIR:-${TMPDIR:-/tmp}/$SOURCE_ID}"

TOKEN_NAME="jira"
CACHE_TTL=300
TOKEN_TTL_MS=900000
SUMMARY_MAX=48
JIRA_PROJECTS="KR,KRI"
KEY_PATTERN=""
LINK_WORDS='(fix(es|ed)?|close[sd]?|resolve[sd]?|implement(s|ed)?|relate[sd]? to|ticket|issue|jira)'
JIRA_URL=""
JIRA_AUTH="bearer"
JIRA_LOGIN=""
JIRA_API_TOKEN="${JIRA_API_TOKEN:-}"
JIRA_API_TOKEN_CMD=""
TOKEN_CMD_TIMEOUT=10
GH_ACCOUNTS="ladislav@prskavec.net=abtris;lprskavec@purestorage.com=lprskavec_pure"

if [ -f "$CONFIG_DIR/config.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$CONFIG_DIR/config.env"
  set +a
fi

# Fall back to the ankitpokhrel/jira-cli config for the instance URL and login.
JIRA_CLI_CONFIG="$HOME/.config/.jira/.config.yml"
if [ -z "$JIRA_URL" ] && [ -f "$JIRA_CLI_CONFIG" ]; then
  JIRA_URL=$(sed -n 's/^server: *//p' "$JIRA_CLI_CONFIG" | head -1)
  [ -n "$JIRA_LOGIN" ] || JIRA_LOGIN=$(sed -n 's/^login: *//p' "$JIRA_CLI_CONFIG" | head -1)
fi
JIRA_URL="${JIRA_URL%/}"

# Restrict candidate keys to the project prefixes that actually exist here. This
# is what keeps branch names like fix/retry-2 from ever looking like a ticket.
# Longest prefix first, so KRI-1 is not read as the KR project.
if [ -z "$KEY_PATTERN" ]; then
  if [ -n "$JIRA_PROJECTS" ]; then
    KEY_PATTERN="($(printf '%s' "$JIRA_PROJECTS" |
      tr ',' '\n' |
      sed 's/[[:space:]]//g' |
      awk 'NF { print length, $0 }' |
      sort -rn |
      cut -d' ' -f2- |
      paste -sd'|' -))-[0-9]+"
  else
    KEY_PATTERN='[A-Za-z][A-Za-z0-9]+-[0-9]+'
  fi
fi

file_mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

# Bounds a command's wall clock. The token command reaches a secret manager, and a
# locked vault would otherwise leave an event hook hanging on every pane focus.
bounded() {
  local secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  elif command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$secs" "$@"
  else
    "$@"
  fi
}

jira_token() {
  if [ -n "$JIRA_API_TOKEN" ]; then
    printf '%s' "$JIRA_API_TOKEN"
  elif [ -n "$JIRA_API_TOKEN_CMD" ]; then
    bounded "$TOKEN_CMD_TIMEOUT" sh -c "$JIRA_API_TOKEN_CMD" 2>/dev/null || true
  fi
}

# --- pane and repo discovery -------------------------------------------------

pane_id() {
  if [ -n "${HERDR_PANE_ID:-}" ]; then
    printf '%s' "$HERDR_PANE_ID"
    return
  fi
  local json id
  for json in "${HERDR_PLUGIN_EVENT_JSON:-}" "${HERDR_PLUGIN_CONTEXT_JSON:-}"; do
    [ -n "$json" ] || continue
    id=$(printf '%s' "$json" |
      jq -r '.pane.pane_id // .pane_id // .focused_pane_id // empty' 2>/dev/null || true)
    if [ -n "$id" ]; then
      printf '%s' "$id"
      return
    fi
  done
}

pane_cwd() {
  local target="$1" json dir
  for json in "${HERDR_PLUGIN_EVENT_JSON:-}" "${HERDR_PLUGIN_CONTEXT_JSON:-}"; do
    [ -n "$json" ] || continue
    dir=$(printf '%s' "$json" |
      jq -r '.pane.foreground_cwd // .pane.cwd // .focused_pane_cwd // .workspace_cwd // empty' \
        2>/dev/null || true)
    if [ -n "$dir" ] && [ -d "$dir" ]; then
      printf '%s' "$dir"
      return
    fi
  done
  # `pane get` wraps the pane in .result.pane, unlike `pane list`, which uses
  # .result.panes. Tolerate both shapes and a bare pane object.
  "$HERDR" pane get "$target" 2>/dev/null |
    jq -r 'if has("result") then .result else . end | (.pane // .) |
      .foreground_cwd // .cwd // empty' 2>/dev/null || true
}

# --- GitHub ------------------------------------------------------------------

# Herdr plugins run outside an interactive shell, so the dotfiles `gh` wrapper
# that picks an account per repo is not loaded. Repeat that selection here from
# the repo's configured user.email, or an EMU token gets used on personal repos.
gh_token_for() {
  local repo_root="$1" email account pair saved_ifs
  email=$(git -C "$repo_root" config user.email 2>/dev/null || true)
  [ -n "$email" ] || return 0
  account=""
  saved_ifs="$IFS"
  IFS=';'
  for pair in $GH_ACCOUNTS; do
    case "$pair" in
      "$email="*) account="${pair#*=}" ;;
    esac
  done
  IFS="$saved_ifs"
  [ -n "$account" ] || return 0
  gh auth token --user "$account" 2>/dev/null || true
}

repo_slug() {
  local url
  url=$(git -C "$1" config --get remote.origin.url 2>/dev/null || true)
  [ -n "$url" ] || return 0
  url="${url%.git}"
  url="${url%/}"
  printf '%s' "$url" | sed -n 's#^.*[:/]\([^/:]*\)/\([^/]*\)$#\1/\2#p'
}

gh_pr_list() {
  local slug="$1" branch="$2" state="$3" token="$4"
  if [ -n "$token" ]; then
    GH_TOKEN="$token" GH_PAGER="cat" gh pr list \
      --repo "$slug" --head "$branch" --state "$state" --limit 1 \
      --json number,title,body 2>/dev/null || true
  else
    GH_PAGER="cat" gh pr list \
      --repo "$slug" --head "$branch" --state "$state" --limit 1 \
      --json number,title,body 2>/dev/null || true
  fi
}

# Prints the PR for this branch as "number<TAB>title<TAB>body", or nothing.
find_pr() {
  local repo_root="$1" branch="$2" slug token state raw parsed
  slug=$(repo_slug "$repo_root")
  [ -n "$slug" ] || return 0
  token=$(gh_token_for "$repo_root")
  for state in open all; do
    raw=$(gh_pr_list "$slug" "$branch" "$state" "$token")
    parsed=$(printf '%s' "$raw" |
      jq -r '.[0] | select(.) | [.number, .title, ((.body // "") | gsub("[\r\n\t]+"; " "))] | @tsv' \
        2>/dev/null || true)
    if [ -n "$parsed" ]; then
      printf '%s' "$parsed"
      return 0
    fi
  done
}

# --- Jira --------------------------------------------------------------------

# Prints "summary<TAB>status". Exit 3 = no such issue, 4 = Jira could not be
# consulted at all (missing token, network, auth).
# Populates JIRA_AUTH_ARGS for curl. Bearer is the personal access token form used
# by Jira Data Center; basic pairs JIRA_LOGIN with the token, as Jira Cloud wants.
JIRA_AUTH_ARGS=()
jira_auth_args() {
  local token="$1"
  if [ "$JIRA_AUTH" = "basic" ]; then
    JIRA_AUTH_ARGS=(-u "$JIRA_LOGIN:$token")
  else
    JIRA_AUTH_ARGS=(-H "Authorization: Bearer $token")
  fi
}

jira_issue() {
  local key="$1" token response code body
  local -a auth
  token=$(jira_token)
  if [ -z "$JIRA_URL" ] || [ -z "$token" ]; then
    return 4
  fi
  jira_auth_args "$token"
  auth=("${JIRA_AUTH_ARGS[@]}")
  response=$(curl -sS -m 8 -w '\n%{http_code}' "${auth[@]}" \
    -H 'Accept: application/json' \
    "$JIRA_URL/rest/api/2/issue/$key?fields=summary,status" 2>/dev/null || true)
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$code" in
    200) ;;
    404) return 3 ;;
    *) return 4 ;;
  esac
  printf '%s' "$body" |
    jq -r '[(.fields.summary // ""), (.fields.status.name // "")] | @tsv' 2>/dev/null || return 4
}

jira_issue_exists() {
  jira_issue "$1" >/dev/null 2>&1
}

extract_keys() {
  printf '%s' "$1" | grep -oiE "$KEY_PATTERN" 2>/dev/null | tr '[:lower:]' '[:upper:]' || true
}

# A PR body mentions tickets in passing far too often for a bare key to mean
# "this is the issue" — prose, examples, and follow-up notes all match. Only
# count keys inside a Jira link or behind a linking word.
extract_linked_keys() {
  local text="$1"
  {
    printf '%s' "$text" | grep -oiE "browse/$KEY_PATTERN" | sed 's#.*/##' || true
    printf '%s' "$text" |
      grep -oiE "${LINK_WORDS}[[:space:]:#-]*$KEY_PATTERN" |
      grep -oiE "$KEY_PATTERN" || true
  } | tr '[:lower:]' '[:upper:]' | sort -u | head -3
}

list_contains() {
  case " $2 " in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

trim_summary() {
  local text="$1"
  # Real Jira summaries carry stray leading and trailing whitespace, which would
  # show up in the line as a doubled separator.
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"
  if [ "${#text}" -gt "$SUMMARY_MAX" ]; then
    text="${text:0:$SUMMARY_MAX}"
    text="${text%"${text##*[![:space:]]}"}"
    printf '%s…' "$text"
  else
    printf '%s' "$text"
  fi
}

# --- resolution --------------------------------------------------------------

# Reads candidate "key<TAB>origin" lines on stdin and prints the first key Jira
# confirms as "key<TAB>summary<TAB>status<TAB>origin". Exit 3 = candidates
# existed but none resolved, 4 = Jira unreachable, 1 = no candidates.
first_real_issue() {
  local key origin details rc saw=0 unreachable=0
  while IFS="$TAB" read -r key origin; do
    [ -n "$key" ] || continue
    saw=1
    details=$(jira_issue "$key") && rc=0 || rc=$?
    if [ "$rc" -eq 0 ]; then
      printf '%s\t%s\t%s\n' "$key" "$details" "$origin"
      return 0
    fi
    if [ "$rc" -eq 4 ]; then
      unreachable=1
    fi
  done
  if [ "$unreachable" -eq 1 ]; then
    return 4
  fi
  if [ "$saw" -eq 1 ]; then
    return 3
  fi
  return 1
}

# Prints the first key from the candidate list, for the failure messages.
first_key() {
  printf '%s' "$1" | head -1 | cut -d"$TAB" -f1
}

compose() {
  local repo_root="$1" branch="$2"
  local pr number title body branch_keys title_keys body_keys candidates key
  local resolved status summary issue_status origin key2

  pr=$(find_pr "$repo_root" "$branch")
  # No PR for this branch: report nothing, so the sidebar row disappears.
  [ -n "$pr" ] || return 0
  IFS="$TAB" read -r number title body <<<"$pr"

  branch_keys=$(extract_keys "$branch")
  title_keys=$(extract_keys "$title")
  body_keys=$(extract_linked_keys "${body:-}")

  candidates=""
  for key in $branch_keys; do candidates+="$key${TAB}branch"$'\n'; done
  for key in $title_keys; do candidates+="$key${TAB}PR title"$'\n'; done
  for key in $body_keys; do candidates+="$key${TAB}PR body"$'\n'; done

  resolved=$(printf '%s' "$candidates" | first_real_issue) && status=0 || status=$?

  case "$status" in
    0)
      IFS="$TAB" read -r key summary issue_status origin <<<"$resolved"

      # The point of the plugin: if the branch and the PR text each name a real
      # but different issue, the PR is probably linked to the wrong ticket.
      if [ "$origin" = "branch" ]; then
        for key2 in $title_keys $body_keys; do
          if [ "$key2" != "$key" ] && jira_issue_exists "$key2"; then
            printf '⚠ #%s %s (branch) ≠ %s (PR)' "$number" "$key" "$key2"
            return 0
          fi
        done
        # The branch carries the assignment, and the PR title is where it has to
        # end up. A ticket that never made it out of the branch name is the
        # agent quietly dropping it.
        if ! list_contains "$key" "$title_keys"; then
          printf '⚠ #%s %s not in PR title' "$number" "$key"
          return 0
        fi
      else
        for key2 in $branch_keys; do
          if [ "$key2" != "$key" ] && jira_issue_exists "$key2"; then
            printf '⚠ #%s %s (branch) ≠ %s (PR)' "$number" "$key2" "$key"
            return 0
          fi
        done
      fi

      printf '#%s %s %s' "$number" "$key" "$(trim_summary "$summary")"
      if [ -n "$issue_status" ]; then
        printf ' · %s' "$issue_status"
      fi
      ;;
    3) printf '⚠ #%s %s not in Jira' "$number" "$(first_key "$candidates")" ;;
    4)
      key=$(first_key "$candidates")
      if [ -n "$key" ]; then
        printf '#%s %s · jira?' "$number" "$key"
      else
        printf '#%s' "$number"
      fi
      ;;
    # No ticket anywhere is normal: chore work, triage, and repos that do not
    # use Jira at all. Show the PR alone rather than nagging.
    *) printf '#%s' "$number" ;;
  esac
}

report() {
  local target="$1" value="$2"
  if [ -n "$value" ]; then
    "$HERDR" pane report-metadata "$target" \
      --source "$SOURCE_ID" \
      --token "$TOKEN_NAME=$value" \
      --ttl-ms "$TOKEN_TTL_MS" >/dev/null
  else
    "$HERDR" pane report-metadata "$target" \
      --source "$SOURCE_ID" \
      --clear-token "$TOKEN_NAME" >/dev/null
  fi
}

cmd_refresh() {
  local force=0 target cwd repo_root branch slug cache age value
  if [ "${1:-}" = "--force" ]; then
    force=1
  fi

  target=$(pane_id)
  [ -n "$target" ] || exit 0

  cwd=$(pane_cwd "$target")
  { [ -n "$cwd" ] && [ -d "$cwd" ]; } || exit 0

  repo_root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null || true)
  branch=""
  if [ -n "$repo_root" ]; then
    branch=$(git -C "$repo_root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  fi
  if [ -z "$branch" ]; then
    report "$target" ""
    exit 0
  fi

  mkdir -p "$STATE_DIR/cache"
  slug=$(printf '%s|%s' "$repo_root" "$branch" | shasum | cut -d' ' -f1)
  cache="$STATE_DIR/cache/$slug"

  if [ "$force" -eq 0 ] && [ -f "$cache" ]; then
    age=$(( $(date +%s) - $(file_mtime "$cache") ))
    if [ "$age" -lt "$CACHE_TTL" ]; then
      report "$target" "$(cat "$cache")"
      exit 0
    fi
  fi

  value=$(compose "$repo_root" "$branch")
  printf '%s' "$value" >"$cache.tmp" && mv "$cache.tmp" "$cache"
  report "$target" "$value"
}

cmd_doctor() {
  local tool
  printf 'plugin        %s\n' "$SOURCE_ID"
  printf 'config dir    %s\n' "$CONFIG_DIR"
  printf 'state dir     %s\n' "$STATE_DIR"
  printf 'sidebar token $%s\n' "$TOKEN_NAME"
  printf 'jira url      %s\n' "${JIRA_URL:-(unset)}"
  printf 'jira auth     %s\n' "$JIRA_AUTH"
  local token code who
  token=$(jira_token)
  if [ -n "$token" ]; then
    if [ -n "$JIRA_API_TOKEN_CMD" ]; then
      printf 'jira token    %s chars, from JIRA_API_TOKEN_CMD\n' "${#token}"
    else
      printf 'jira token    %s chars, from JIRA_API_TOKEN\n' "${#token}"
    fi
    # One request, so a rejected token is obvious here instead of showing up as a
    # sidebar full of "jira?". On-prem Jira can lock an account after repeated
    # failures, so this deliberately does not retry or try other auth modes.
    jira_auth_args "$token"
    code=$(curl -sS -m 10 -o /dev/null -w '%{http_code}' "${JIRA_AUTH_ARGS[@]}" \
      -H 'Accept: application/json' "$JIRA_URL/rest/api/2/myself" 2>/dev/null || true)
    case "$code" in
      200)
        who=$(curl -sS -m 10 "${JIRA_AUTH_ARGS[@]}" -H 'Accept: application/json' \
          "$JIRA_URL/rest/api/2/myself" 2>/dev/null | jq -r '.name // "?"' 2>/dev/null)
        printf 'jira auth     HTTP 200 as %s\n' "${who:-?}"
        ;;
      401 | 403)
        printf 'jira auth     HTTP %s — token rejected, or this instance restricts\n' "$code"
        printf '              /myself. Confirm with: jira issue view <KEY>\n'
        ;;
      429) printf 'jira auth     HTTP 429 — rate limited, wait before retrying\n' ;;
      *) printf 'jira auth     HTTP %s\n' "${code:-no response}" ;;
    esac
  else
    printf 'jira token    MISSING — set JIRA_API_TOKEN or JIRA_API_TOKEN_CMD in\n'
    printf '              %s/config.env\n' "$CONFIG_DIR"
  fi
  for tool in git gh jq curl; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '%-13s %s\n' "$tool" "$(command -v "$tool")"
    else
      printf '%-13s MISSING\n' "$tool"
    fi
  done
}

case "${1:-refresh}" in
  refresh)
    shift || true
    cmd_refresh "${1:-}"
    ;;
  doctor) cmd_doctor ;;
  *)
    printf 'usage: jira-pr [refresh [--force]|doctor]\n' >&2
    exit 64
    ;;
esac
